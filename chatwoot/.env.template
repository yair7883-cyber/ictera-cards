# Chatwoot settings. install.sh copies this to .env and fills in the
# __GENERATED__ secrets. Never commit .env.
# Full list of options: https://github.com/chatwoot/chatwoot/blob/develop/.env.example

# Public address people will open (e.g. https://chat.example.com)
FRONTEND_URL=http://localhost:3000
FORCE_SSL=false
DEFAULT_LOCALE=he
INSTALLATION_NAME=Chatwoot
# false = only you can create users (you invite your team from the dashboard)
ENABLE_ACCOUNT_SIGNUP=false

SECRET_KEY_BASE=__GENERATED__

POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_DATABASE=chatwoot
POSTGRES_PASSWORD=__GENERATED__

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=__GENERATED__

RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
ACTIVE_STORAGE_SERVICE=local

# Email (optional, needed for invitations and password resets)
MAILER_SENDER_EMAIL=Chatwoot <no-reply@example.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
